# GetOnlyPros Production Environment
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/getonlypros?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-random-64-char-string>
JWT_REFRESH_SECRET=<generate-different-random-64-char-string>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=https://getonlypros.com

# Resend Email
RESEND_API_KEY=<resend-api-key>

# Stripe Payments
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

# Tango Card (Gift Cards)
TANGO_CARD_API_KEY=<tango-card-api-key>

# Twilio SMS
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE_NUMBER=<twilio-phone>

# Redis (optional - caching)
REDIS_URL=redis://localhost:6379
